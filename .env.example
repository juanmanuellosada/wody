# URL de conexión principal a la base de datos (branch de producción/desarrollo en Neon).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# URL de la shadow database para `prisma migrate dev` (branch dedicado en Neon, distinto del principal).
# Crear un branch separado en Neon, copiar su connection string aquí.
# Solo necesaria para correr migraciones en desarrollo local; no se usa en producción.
SHADOW_DATABASE_URL="postgresql://user:password@shadow-host/dbname?sslmode=require"

AUTH_SECRET="your-auth-secret"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:you@example.com"
CRON_SECRET="your-cron-secret"
CHECKIN_TOKEN_SECRET="your-checkin-token-secret"

# ── Email (Resend) ─────────────────────────────────────────────────────────────

# API key de Resend. Obtenerla en resend.com → API Keys. Formato: re_xxx...
RESEND_API_KEY="re_xxx_replace_me"

# Remitente de todos los mails transaccionales. Requiere dominio verificado en Resend.
EMAIL_FROM="Wody <noreply@wody.com.ar>"

# (Opcional) Si está seteada, los mails incluyen un header Reply-To con esta dirección.
# Útil para que las respuestas de los alumnos lleguen a un inbox monitoreado.
EMAIL_REPLY_TO=""

# Destinatario de las alertas automáticas de cuota (80 % y 95 % del límite mensual).
EMAIL_QUOTA_ALERT_TO="you@example.com"

# Límite mensual de envíos. Plan contratado: Resend Transactional Pro (50 000/mes).
# IMPORTANTE: también hay que setearla en Vercel (Production y Preview) — el default de
# 3000 corresponde al free tier y dispara las alertas de cuota en falso.
EMAIL_QUOTA_MONTHLY_LIMIT=50000

# URL base de la app, sin slash final. Se usa para construir los links de activación y reset.
APP_URL="https://wody.com.ar"

# ── Mercado Pago (suscripciones de gyms y Wody Personal) ─────────────────────

# Access token de producción de MP (panel de credenciales → Producción).
MP_ACCESS_TOKEN="APP_USR-your-access-token"

# [YA NO REQUERIDA] Public key de MP para el front (MP Bricks / CardForm — tokenización client-side).
# La captura de tarjeta in-app fue reemplazada por un flujo de redirect vía init_point.
# Esta variable puede removerse del entorno de producción.
# NEXT_PUBLIC_MP_PUBLIC_KEY="APP_USR-your-public-key"

# Secret para validar la firma HMAC-SHA256 de los webhooks de MP.
# Se genera en el panel de Webhooks de MP al configurar la URL del endpoint.
MP_WEBHOOK_SECRET="your-webhook-secret"

# ── Vercel Blob ────────────────────────────────────────────────────────────────

# Token de lectura/escritura para Vercel Blob. Se genera automáticamente al
# conectar el store desde el dashboard de Vercel (ver docs/vercel-blob.md).
# No copiar este valor a mano — Vercel lo inyecta en las envs del proyecto.
BLOB_READ_WRITE_TOKEN=
