// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  ACCESS
  SUPERADMIN
}

enum GymKind {
  GYM
  BOX
  PERSONAL
}

enum StudentType {
  GENERAL
  PERSONALIZED
  MUSCULACION_LIBRE
}

enum WodTargetType {
  ALL
  PERSONALIZED
  GROUP
  STUDENT
}

enum CouponRule {
  ONCE_PER_USER
  ONCE_PER_USER_PER_MONTH
  ONCE_GLOBAL
  UNLIMITED
}

enum RedemptionStatus {
  PENDING
  CONSUMED
}

enum AccessState {
  PENDING
  GRANTED
  DENIED
}

enum VerificationTokenType {
  INVITE
  RESET
}

enum EmailLogType {
  INVITE
  RESET
  QUOTA_ALERT_80
  QUOTA_ALERT_95
  JOIN_APPROVED
  PERSONAL_WELCOME
  LEAD_RECEIVED
  LEAD_APPROVED
  LEAD_REJECTED
  PAYMENT_FAILED
  PERSONAL_LEAD_RECEIVED
  PERSONAL_LEAD_APPROVED
  PERSONAL_LEAD_REJECTED
  PERSONAL_PAYMENT_FAILED
}

enum SignupRequestType {
  GYM
  PERSONAL
}

enum SignupRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  EXPIRED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  MERCADO_PAGO
}

enum EmailLogStatus {
  SENT
  FAILED
}

enum AccountKind {
  FULL
  LITE
}

model Gym {
  id                          String        @id @default(cuid())
  name                        String
  slug                        String        @unique
  kind                        GymKind       @default(BOX)
  logo                        String?
  primaryColor                String?
  createdAt                   DateTime      @default(now())
  blockedAt                   DateTime?
  autoBlockAfterDays          Int           @default(45)
  nextMemberNumber            Int           @default(1)
  nextProductCode             Int           @default(1)
  subscriptionNextPaymentDate DateTime?
  subscriptionMonthlyAmount   Int?          @default(40000)
  trialEndsAt                 DateTime?
  paymentExempt               Boolean       @default(false)
  paymentExemptReason         String?
  selfManagedBilling              Boolean       @default(false)
  mpPreapprovalId                 String?
  mpSubscriptionStatus            String?
  mpSubscriptionStatusChangedAt   DateTime?
  users                       User[]
  accessLogs                  AccessLog[]
  fixedRoutines               FixedRoutine[]
  emailLogs                   EmailLog[]
  joinRequests                JoinRequest[]
  payments                    Payment[]
  signupRequest               GymSignupRequest?
  productCategories           ProductCategory[]
  products                    Product[]
  sales                       Sale[]
  expenses                    Expense[]
}

model User {
  id                   String      @id @default(cuid())
  email                String?
  password             String?
  accountKind          AccountKind @default(FULL)
  name                 String
  role                 Role
  studentType          StudentType @default(PERSONALIZED)
  canCreateOwnRoutines Boolean     @default(false)
  canViewRevenue       Boolean     @default(false)
  gymId                String?
  createdAt            DateTime    @default(now())
  nextPaymentDate      DateTime    @default(now()) @db.Date
  blockedAt            DateTime?
  deletedAt            DateTime?
  lastDueNotifiedOn    DateTime?   @db.Date
  memberNumber         Int
  emailVerifiedAt      DateTime?
  paymentExempt        Boolean     @default(false)
  paymentExemptReason  String?
  mpPreapprovalId               String?
  mpSubscriptionStatus          String?
  mpSubscriptionStatusChangedAt DateTime?
  trialEndsAt                   DateTime?

  gym Gym? @relation(fields: [gymId], references: [id])

  wodsAsTeacher        Wod[]                @relation("TeacherWods")
  wodsTargetedTo       Wod[]                @relation("WodTargetStudent")
  rms                  RM[]
  teacherOf            TeacherStudent[]     @relation("TeacherRel")
  studentOf            TeacherStudent[]     @relation("StudentRel")
  teacherGroups        Group[]              @relation("TeacherGroups")
  groupMemberships     GroupMember[]
  redemptions          CouponRedemption[]
  pushSubscriptions    PushSubscription[]
  accessesAsUser       AccessLog[]          @relation("AccessLogUser")
  accessesDecidedBy    AccessLog[]          @relation("AccessLogDecidedBy")
  verificationTokens   VerificationToken[]
  joinRequestTeachers  JoinRequestTeacher[] @relation("JoinRequestTeacherToUser")
  joinRequestsReviewed JoinRequest[]        @relation("JoinRequestReviewer")
  paymentsAsPayer           Payment[]            @relation("PaymentStudent")
  paymentsRecorded          Payment[]            @relation("PaymentRecordedBy")
  createdSignupRequests     GymSignupRequest[]
  fixedRoutinesAsStudent    FixedRoutine[]       @relation("FixedRoutineStudent")
  fixedRoutinesAsTeacher    FixedRoutine[]       @relation("FixedRoutineTeacher")
  salesRecorded             Sale[]               @relation("SaleRecordedBy")
  expensesRecorded          Expense[]            @relation("ExpenseRecordedBy")

  // Unicidades parciales (solo filas activas, deletedAt IS NULL).
  // Los índices únicos totales fueron reemplazados por índices únicos parciales
  // de PostgreSQL en la migration add_user_soft_delete. Prisma no soporta WHERE
  // en @@unique, por eso se usan @@index no únicos aquí para mantener la
  // ergonomía de queries (findUnique por email_gymId / gymId_memberNumber).
  @@index([email, gymId])
  @@index([gymId, memberNumber])
  @@index([gymId, deletedAt])
}

model Group {
  id        String    @id @default(cuid())
  name      String
  teacherId String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  teacher User          @relation("TeacherGroups", fields: [teacherId], references: [id], onDelete: Cascade)
  members GroupMember[]
  wods    Wod[]         @relation("WodTargetGroup")

  // Unicidad parcial: solo entre grupos activos del mismo profe.
  // El índice único parcial vive en la migration add_user_soft_delete.
  @@index([teacherId, name])
}

model GroupMember {
  userId  String
  groupId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
}

model Wod {
  id              String        @id @default(cuid())
  title           String        @default("WOD")
  content         String
  date            DateTime      @db.Date
  teacherId       String
  targetType      WodTargetType @default(ALL)
  targetGroupId   String?
  targetStudentId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  teacher       User   @relation("TeacherWods", fields: [teacherId], references: [id], onDelete: Cascade)
  targetGroup   Group? @relation("WodTargetGroup", fields: [targetGroupId], references: [id], onDelete: SetNull)
  targetStudent User?  @relation("WodTargetStudent", fields: [targetStudentId], references: [id], onDelete: SetNull)

  @@index([teacherId, date(sort: Desc)])
}

model RM {
  id        String   @id @default(cuid())
  exercise  String
  weight    Float
  date      DateTime @db.Date
  studentId String
  createdAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("PR")
}

model TeacherStudent {
  teacherId String
  studentId String

  teacher User @relation("TeacherRel", fields: [teacherId], references: [id], onDelete: Cascade)
  student User @relation("StudentRel", fields: [studentId], references: [id], onDelete: Cascade)

  @@id([teacherId, studentId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AccessLog {
  id          String      @id @default(cuid())
  gymId       String
  userId      String
  at          DateTime    @default(now())
  state       AccessState @default(PENDING)
  decidedById String?
  decidedAt   DateTime?

  gym       Gym   @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user      User  @relation("AccessLogUser", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("AccessLogDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([gymId, state, at])
  @@index([gymId, at(sort: Desc)])
  @@index([userId])
}

model Coupon {
  id                   String     @id @default(cuid())
  slug                 String     @unique
  name                 String
  description          String
  instagramHandle      String
  instagramUrl         String
  logoKey              String?
  rule                 CouponRule
  active               Boolean    @default(true)
  sortOrder            Int        @default(0)
  requiresConsumedSlug String?
  hideWhenConsumed     Boolean    @default(false)
  expiresAt            DateTime?
  fixedCode            String?
  websiteUrl           String?
  restrictions         String?
  createdAt            DateTime   @default(now())

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id         String           @id @default(cuid())
  code       String           @unique
  couponId   String
  userId     String
  status     RedemptionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  consumedAt DateTime?

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, couponId])
  @@index([couponId, status])
}

model VerificationToken {
  id         String                @id @default(cuid())
  userId     String
  tokenHash  String                @unique
  type       VerificationTokenType
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model JoinRequest {
  id              String            @id @default(cuid())
  gymId           String
  gym             Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name            String
  email           String
  passwordHash    String
  nextPaymentDate DateTime          @db.Date
  studentType     StudentType       @default(PERSONALIZED)
  status          JoinRequestStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?             @relation("JoinRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  createdAt       DateTime          @default(now())

  teachers JoinRequestTeacher[]

  @@index([gymId, status, createdAt])
}

model JoinRequestTeacher {
  joinRequestId String
  teacherId     String
  createdAt     DateTime @default(now())

  joinRequest JoinRequest @relation(fields: [joinRequestId], references: [id], onDelete: Cascade)
  teacher     User        @relation("JoinRequestTeacherToUser", fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([joinRequestId, teacherId])
  @@index([teacherId])
}

model EmailLog {
  id           String         @id @default(cuid())
  gymId        String?
  to           String
  type         EmailLogType
  resendId     String?
  status       EmailLogStatus
  errorMessage String?
  sentAt       DateTime       @default(now())

  gym Gym? @relation(fields: [gymId], references: [id], onDelete: SetNull)

  @@index([sentAt, status])
  @@index([type, sentAt])
}

model PersonalAccessWhitelist {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  note       String?
  createdAt  DateTime  @default(now())
  consumedAt DateTime?
}

model Payment {
  id            String         @id @default(cuid())
  gymId         String
  studentId     String
  amount        Decimal        @db.Decimal(12, 2)
  paidAt        DateTime
  paymentMethod PaymentMethod?
  recordedById  String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  gym        Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  student    User @relation("PaymentStudent", fields: [studentId], references: [id], onDelete: Restrict)
  recordedBy User @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([gymId, paidAt])
  @@index([studentId])
}

model ProductCategory {
  id        String    @id @default(cuid())
  gymId     String
  name      String
  createdAt DateTime  @default(now())

  gym      Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([gymId, name])
  @@index([gymId])
}

model Product {
  id          String    @id @default(cuid())
  gymId       String
  code        Int
  description String
  categoryId  String
  salePrice   Decimal   @db.Decimal(12, 2)
  stock       Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  gym      Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sales    Sale[]

  // Unicidad parcial: (gymId, code) solo entre productos activos (deletedAt IS
  // NULL). Prisma no soporta WHERE en @@unique, por eso el índice único real
  // vive en la migration SQL (mismo patrón que User.memberNumber) y acá solo
  // declaramos el índice no único para la ergonomía de queries.
  @@index([gymId, code])
  @@index([gymId])
}

model Sale {
  id            String        @id @default(cuid())
  gymId         String
  productId     String
  quantity      Int
  unitAmount    Decimal       @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  soldAt        DateTime
  recordedById  String
  createdAt     DateTime      @default(now())

  gym        Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  recordedBy User    @relation("SaleRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([gymId, soldAt])
}

model Expense {
  id           String   @id @default(cuid())
  gymId        String
  amount       Decimal  @db.Decimal(12, 2)
  description  String
  spentAt      DateTime
  recordedById String
  createdAt    DateTime @default(now())

  gym        Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  recordedBy User @relation("ExpenseRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([gymId, spentAt])
}

model GymSignupRequest {
  id                  String               @id @default(cuid())
  type                SignupRequestType    @default(GYM)
  email               String
  contactName         String
  gymName             String?
  gymKindSuggested    String?
  phone               String?
  expectedStudents    Int?
  message             String?
  status              SignupRequestStatus  @default(PENDING)
  createdAt           DateTime             @default(now())
  approvedAt          DateTime?
  rejectedAt          DateTime?
  completedAt         DateTime?
  onboardingToken     String?              @unique
  tokenExpiresAt      DateTime?
  rejectionReason     String?
  gymId               String?              @unique
  createdByAdminId    String?

  gym            Gym?  @relation(fields: [gymId], references: [id], onDelete: SetNull)
  createdByAdmin User? @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([email, status])
}

model SignupRequestRateLimit {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

model FixedRoutine {
  id                    String    @id @default(cuid())
  gymId                 String
  studentId             String
  teacherId             String
  title                 String
  content               String
  assignedAt            DateTime  @default(now())
  renewAt               DateTime  @db.Date
  lastRenewalNotifiedOn DateTime? @db.Date
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  gym     Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  student User @relation("FixedRoutineStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher User @relation("FixedRoutineTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([studentId, deletedAt])
  @@index([teacherId, renewAt])
}
